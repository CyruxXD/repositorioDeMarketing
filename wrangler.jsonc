{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "repositoriodemarketing",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/recursos/VM/video-vm-promo.mp4",
      "/recursos/video-desktop.mp4",
      "/recursos/video-mobile.mp4"
    ]
  }
}
